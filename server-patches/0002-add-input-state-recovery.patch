+    private void resetInputState() {
+        boolean hadTrackedPointers = pointersState.size() > 0;
+        boolean globalCanceled = ServiceManager.getInputManager().cancelCurrentTouch();
+        boolean trackedCanceled = false;
+
+        if (!globalCanceled && hadTrackedPointers) {
+            long now = SystemClock.uptimeMillis();
+            int pointerCount = pointersState.update(pointerProperties, pointerCoords);
+            int targetDisplayId = lastTouchDisplayId != Device.DISPLAY_ID_NONE ? lastTouchDisplayId : getActionDisplayId();
+            if (pointerCount > 0 && targetDisplayId != Device.DISPLAY_ID_NONE) {
+                long downTime = lastTouchDown != 0 ? lastTouchDown : now;
+                MotionEvent cancelEvent = MotionEvent.obtain(downTime, now, MotionEvent.ACTION_CANCEL, pointerCount, pointerProperties,
+                        pointerCoords, 0, 0, 1f, 1f, DEFAULT_DEVICE_ID, 0, lastTouchSource, 0);
+                trackedCanceled = Device.injectEvent(cancelEvent, targetDisplayId, Device.INJECT_MODE_WAIT_FOR_FINISH);
+                cancelEvent.recycle();
+            }
+        }
+
+        pointersState.clear();
+        lastTouchDown = 0;
+        lastTouchDisplayId = Device.DISPLAY_ID_NONE;
+        lastTouchSource = InputDevice.SOURCE_TOUCHSCREEN;
+        // A reset is sent before every new desktop gesture. Only log the
+        // exceptional case where scrcpy actually found a stale pointer, so the
+        // normal FPS/click path does not flood adb output or add log overhead.
+        if (hadTrackedPointers) {
+            Ln.d("Recovered stale input state: global=" + globalCanceled + ", tracked=" + trackedCanceled);
+        }
+    }

+void ToolForm::on_pauseVideoBtn_clicked()
+{
+    auto videoForm = qobject_cast<VideoForm*>(parentWidget());
+    if (!videoForm) {
+        return;
+    }
+    const bool paused = videoForm->toggleVideoPause();
+    ui->pauseVideoBtn->setStyleSheet(paused ? "color: #f0c419" : "");
+    ui->pauseVideoBtn->setToolTip(paused
+        ? tr("resume device video capture (Ctrl+Shift+P)")
+        : tr("pause device video capture (Ctrl+Shift+P)"));
+}

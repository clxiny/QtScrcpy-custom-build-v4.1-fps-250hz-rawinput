+        sendUhidTouch(AMOTION_EVENT_ACTION_UP, m_uhidLastTouchPos, m_uhidLastFrameSize);
+    }
+    if (!enabled && !m_uhidLastFrameSize.isEmpty()) {
+        // Leave proximity before the UHID device is destroyed so Android can
+        // close the drawing-tablet hover stream cleanly.
+        sendUhidPointerInput(0, m_uhidLastTouchPos, m_uhidLastFrameSize, 0, 0, false);
+    }
+    m_mousePassthrough = enabled;
+    m_uhidPointerRange = enabled ? pointerRange : QSize();
+    m_uhidButtonState = 0;
+    m_uhidTouching = false;
+    m_uhidTouchPressPending = false;
+    m_uhidTouchReleasePending = false;
+}
+
+void InputConvertNormal::resetInputState()
+{
+    m_uhidTouchStartTimer.stop();
+    m_uhidTouchReleaseTimer.stop();
+
+    // End drawing-tablet proximity locally. Do not synthesize an UP here:
+    // the matching server reset follows this report and cancels the complete
+    // Android gesture atomically, including any pointer unknown to the client.
+    if (m_mousePassthrough && !m_uhidLastFrameSize.isEmpty()) {
+        sendUhidPointerInput(0, m_uhidLastTouchPos, m_uhidLastFrameSize,
+                             0, 0, false);
+    }
+
+    m_uhidButtonState = 0;
+    m_uhidTouching = false;
+    m_uhidTouchPressPending = false;
+    m_uhidTouchReleasePending = false;
+    m_uhidTouchDownPos = QPoint();
+    m_uhidTouchDownFrameSize = QSize();
+}
+
+quint8 InputConvertNormal::convertUhidMouseButton(Qt::MouseButton button) const
+{
+    switch (button) {
+    case Qt::LeftButton:
+        return 1U << 0;
+    case Qt::RightButton:
+        return 1U << 1;
+#if (QT_VERSION >= QT_VERSION_CHECK(5, 15, 0))
+    case Qt::MiddleButton:
+#else
+    case Qt::MidButton:
+#endif
+        return 1U << 2;
+    case Qt::XButton1:
+        return 1U << 3;
+    case Qt::XButton2:
+        return 1U << 4;
+    default:
+        return 0;
+    }
+}
+
+void InputConvertNormal::sendUhidPointerInput(quint8 buttonBits, const QPoint &pos, const QSize &frameSize,
+                                              int vScroll, int hScroll, bool inRange)
+{
+    if (frameSize.isEmpty()) {
+        return;
+    }
+
+    // Android treats a HID digitizer with INPUT_PROP_POINTER and a stylus tool
+    // as a drawing tablet. Its raw hover stream goes through InputReader and
+    // PointerChoreographer, which keeps the real system mouse arrow visible and
+    // places it at these absolute coordinates. A synthetic SOURCE_MOUSE hover
+    // is delivered only to apps and cannot update that system-owned cursor.
+    const QSize pointerRange = m_uhidPointerRange.isEmpty() ? frameSize : m_uhidPointerRange;
+    const quint16 hidMaxX = static_cast<quint16>(qBound(1, pointerRange.width() - 1, 0xffff));
+    const quint16 hidMaxY = static_cast<quint16>(qBound(1, pointerRange.height() - 1, 0xffff));
+    const auto toHidCoordinate = [](int value, int extent, quint16 hidMaximum) -> quint16 {
+        if (extent <= 1 || !hidMaximum) {
+            return 0;
+        }
+        const int clamped = qBound(0, value, extent - 1);
+        return static_cast<quint16>(qRound64(static_cast<double>(clamped)
+                                             * hidMaximum / (extent - 1)));
+    };
+
+    const quint16 x = toHidCoordinate(pos.x(), frameSize.width(), hidMaxX);
+    const quint16 y = toHidCoordinate(pos.y(), frameSize.height(), hidMaxY);
+
+    // Report layout defined by Controller's drawing-tablet descriptor:
+    // proximity/tip, absolute X, absolute Y, five buttons, wheel and AC Pan.
+    QByteArray report;
+    report.reserve(8);
+    report.append(static_cast<char>(inRange ? 0x02 : 0x00)); // Tip=0, InRange=1
+    report.append(static_cast<char>(x & 0xff));
+    report.append(static_cast<char>((x >> 8) & 0xff));
+    report.append(static_cast<char>(y & 0xff));
+    report.append(static_cast<char>((y >> 8) & 0xff));
+    report.append(static_cast<char>(buttonBits));
+    report.append(static_cast<char>(static_cast<qint8>(qBound(-127, vScroll, 127))));
+    report.append(static_cast<char>(static_cast<qint8>(qBound(-127, hScroll, 127))));
+
+    ControlMsg *controlMsg = new ControlMsg(ControlMsg::CMT_UHID_INPUT);
+    controlMsg->setUhidInputData(2, report);
+    sendControlMsg(controlMsg);
+}
+
+void InputConvertNormal::sendUhidTouch(AndroidMotioneventAction action, const QPoint &pos, const QSize &frameSize)
+{
+    if (frameSize.isEmpty()) {
+        return;
+    }
+    ControlMsg *controlMsg = new ControlMsg(ControlMsg::CMT_INJECT_TOUCH);
+    controlMsg->setInjectTouchMsgData(
+        static_cast<quint64>(POINTER_ID_GENERIC_FINGER),
+        action,
+        static_cast<AndroidMotioneventButtons>(0),
+        static_cast<AndroidMotioneventButtons>(0),
+        QRect(pos, frameSize),
+        action == AMOTION_EVENT_ACTION_UP ? 0.0f : 1.0f);
+    sendControlMsg(controlMsg);
+}
+
+void InputConvertNormal::sendPendingUhidTouchDown()
+{
+    if (!m_mousePassthrough || !m_uhidTouchPressPending
+            || m_uhidTouchDownFrameSize.isEmpty()) {
+        m_uhidTouchPressPending = false;
+        m_uhidTouchReleasePending = false;
+        return;
+    }
+
+    m_uhidTouchPressPending = false;
+    // A real finger may have canceled the previous injected stream without
+    // notifying scrcpy. Reset only at this new-gesture boundary; MOVE packets
+    // and the FPS hot path remain direct and unchanged.
+    requestAndroidInputStateReset();
+    sendUhidTouch(AMOTION_EVENT_ACTION_DOWN, m_uhidTouchDownPos, m_uhidTouchDownFrameSize);
+    m_uhidTouching = true;
+
+    // Very short desktop clicks may be released before the hover-exit timer
+    // fires. Still emit a valid DOWN/UP pair with a small minimum duration.
+    if (m_uhidTouchReleasePending) {
+        m_uhidTouchReleasePending = false;
+        m_uhidTouchReleaseTimer.start(UHID_MIN_TAP_DURATION_MS);
+    }
+}
+
+void InputConvertNormal::sendPendingUhidTouchUp()
+{
+    if (!m_mousePassthrough || !m_uhidTouching) {
+        return;
+    }
+
+    if (!m_uhidLastFrameSize.isEmpty()) {
+        sendUhidTouch(AMOTION_EVENT_ACTION_UP, m_uhidLastTouchPos, m_uhidLastFrameSize);
+    }
+    m_uhidTouching = false;
+
+    // Re-enter proximity only after the finger stream is complete. This keeps
+    // Android 16 from rejecting the click while restoring the system pointer
+    // at exactly the release position.
+    if (!m_uhidLastFrameSize.isEmpty()) {
+        sendUhidPointerInput(m_uhidButtonState, m_uhidLastTouchPos,
+                             m_uhidLastFrameSize, 0, 0, true);
+    }
+}
+
+QPoint InputConvertNormal::mapToVideoFrame(const QPoint &pos, const QSize &frameSize, const QSize &showSize) const
+{
+    if (frameSize.isEmpty() || showSize.isEmpty()) {
+        return QPoint();
+    }
+
+    const QPoint clampedPos(
+        qBound(0, pos.x(), showSize.width() - 1),
+        qBound(0, pos.y(), showSize.height() - 1));
+
+    // Use endpoint-preserving scaling. frameSize is supplied by the current
+    // video session and changes automatically after rotation or display resize.
+    // The Android server then maps this video coordinate to the physical panel
+    // (for example 2136x3200), including capture scaling and rotation.
+    const int x = showSize.width() > 1 && frameSize.width() > 1
+        ? static_cast<int>(qRound64(static_cast<double>(clampedPos.x())
+                                   * (frameSize.width() - 1) / (showSize.width() - 1)))
+        : 0;
+    const int y = showSize.height() > 1 && frameSize.height() > 1
+        ? static_cast<int>(qRound64(static_cast<double>(clampedPos.y())
+                                   * (frameSize.height() - 1) / (showSize.height() - 1)))
+        : 0;
+    return QPoint(x, y);
+}
